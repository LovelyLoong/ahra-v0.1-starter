{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .codex/hooks/evolver-session-start.js",
        "timeout": 3
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .codex/hooks/evolver-signal-detect.js",
        "timeout": 2
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .codex/hooks/evolver-session-end.js",
        "timeout": 8
      }
    ]
  },
  "_evolver_managed": true
}
