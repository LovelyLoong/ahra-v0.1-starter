+def _coerce_resolved_reference(reference: str, value: Any) -> ResolvedProfileReference:
+    if isinstance(value, ResolvedProfileReference):
+        return value
+    if isinstance(value, str):
+        return ResolvedProfileReference(reference=reference, digest=value)
+    payload = _value_to_mapping(value)
+    digest = _optional_text(
+        payload.get("digest")
+        or payload.get("profile_digest")
+        or payload.get("operation_profile_digest")
+        or payload.get("sha256")
+    )
+    if not digest:
+        raise ProfileDigestResolutionError(
+            reference,
+            details={"resolved_type": type(value).__name__},
+        )
+    return ResolvedProfileReference(reference=reference, digest=digest, profile=payload)
