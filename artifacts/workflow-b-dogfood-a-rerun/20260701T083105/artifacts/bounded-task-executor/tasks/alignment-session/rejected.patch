+        "resolve_digest",
+        "resolve_profile_digest",
+        "get_digest",
+        "get_profile_digest",
+        "get_profile",
+        "lookup",
+        "get",
+    )
+    for method_name in methods:
+        method = getattr(registry, method_name, None)
+        if callable(method):
+            try:
+                result = method(reference)
+            except (KeyError, LookupError, ValueError, TypeError):
+                continue
+            if result is not None and result is not False:
+                yield result
+
+    if isinstance(registry, MappingABC) and reference in registry:
+        yield registry[reference]
