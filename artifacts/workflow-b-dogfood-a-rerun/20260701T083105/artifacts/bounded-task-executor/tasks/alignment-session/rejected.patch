+def _call_with_payload(method: Callable[..., Any], payload: dict[str, Any]) -> Any:
+    try:
+        signature = inspect.signature(method)
+    except (TypeError, ValueError):
+        return method(payload)
+
+    params = list(signature.parameters.values())
+    usable = [
+        param
+        for param in params
+        if param.kind
+        in (
+            inspect.Parameter.POSITIONAL_ONLY,
+            inspect.Parameter.POSITIONAL_OR_KEYWORD,
+            inspect.Parameter.KEYWORD_ONLY,
+            inspect.Parameter.VAR_KEYWORD,
+        )
+    ]
+    if not usable:
+        return method()
+
+    names = {param.name for param in usable}
+    for name in ("request", "alignment_request", "agent_request", "payload", "input", "prompt"):
+        if name in names:
+            return method(**{name: payload})
+
+    if any(param.kind == inspect.Parameter.VAR_KEYWORD for param in usable):
+        return method(request=payload)
+
+    positional = [
+        param
+        for param in usable
+        if param.kind
+        in (inspect.Parameter.POSITIONAL_ONLY, inspect.Parameter.POSITIONAL_OR_KEYWORD)
+    ]
+    if len(positional) == 1:
+        return method(payload)
+    return method(payload)
+
