+def _value_to_mapping(value: Any) -> dict[str, Any]:
+    if value is None:
+        return {}
+    if isinstance(value, MappingABC):
+        return {str(key): _thaw(item) for key, item in value.items()}
+    if isinstance(value, RequestDraft):
+        return value.to_dict()
+    if is_dataclass(value):
+        return {field.name: _thaw(getattr(value, field.name)) for field in fields(value)}
+    if hasattr(value, "to_dict") and callable(value.to_dict):
+        result = value.to_dict()
+        if isinstance(result, MappingABC):
+            return {str(key): _thaw(item) for key, item in result.items()}
+    if hasattr(value, "model_dump") and callable(value.model_dump):
+        result = value.model_dump()
+        if isinstance(result, MappingABC):
+            return {str(key): _thaw(item) for key, item in result.items()}
+    attrs = {
+        key: getattr(value, key)
+        for key in dir(value)
+        if not key.startswith("_") and not callable(getattr(value, key, None))
+    }
+    return {str(key): _thaw(item) for key, item in attrs.items()}
+
