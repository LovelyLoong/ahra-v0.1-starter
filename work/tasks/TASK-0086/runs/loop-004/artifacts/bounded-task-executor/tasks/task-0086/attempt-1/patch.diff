index 0000000..d74f9f9
--- /dev/null
+++ b/tests/test_workflow_a_cli.py
@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+from ahra import cli
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _run_cli(argv: list[str], *, cwd: Path) -> tuple[int, dict, str]:
+    stdout = io.StringIO()
+    stderr = io.StringIO()
+    old_cwd = Path.cwd()
+    os.chdir(cwd)
+    try:
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            code = cli.main(argv)
+    finally:
+        os.chdir(old_cwd)
+    payload = json.loads(stdout.getvalue() or stderr.getvalue())
+    return code, payload, stderr.getvalue()
+
+
+class WorkflowAStartTests(unittest.TestCase):
+    def test_start_creates_missing_workspace_artifact_and_store_parent(self) -> None:
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            intent = ROOT / "examples" / "intents" / "phase1-example-intent.yaml"
+            session = Path("workflow-a") / "session" / "session.json"
+            workspace = Path("workflow-a") / "workspace"
+            artifact_dir = Path("workflow-a") / "artifacts"
+            store_path = Path("workflow-a") / "store" / "goal-control.sqlite3"
+
+            code, payload, _ = _run_cli(
+                [
+                    "workflow-a",
+                    "start",
+                    str(intent),
+                    "--session",
+                    str(session),
+                    "--workspace-ref",
+                    str(workspace),
+                    "--artifact-dir",
+                    str(artifact_dir),
+                    "--store-path",
+                    str(store_path),
+                ],
+                cwd=root,
+            )
+
+            expected_workspace = (root / workspace).resolve()
+            expected_artifacts = (root / artifact_dir).resolve()
+            expected_store = (root / store_path).resolve()
+            self.assertEqual(code, 0, payload)
+            self.assertTrue(expected_workspace.is_dir())
+            self.assertTrue(expected_artifacts.is_dir())
+            self.assertTrue(expected_store.parent.is_dir())
+            snapshot = payload["result"]["snapshot"]
+            self.assertEqual(Path(snapshot["workspaceRef"]), expected_workspace)
+            self.assertEqual(Path(snapshot["artifactDir"]), expected_artifacts)
+            self.assertEqual(Path(snapshot["storePath"]), expected_store)
+
+
+if __name__ == "__main__":
+    unittest.main()
