+def _prepare_start_paths(*, workspace_ref: str, artifact_dir: str, store_path: str) -> tuple[str, str, str]:
+    workspace = Path(_normalize_cli_path(workspace_ref))
+    artifacts = Path(_normalize_cli_path(artifact_dir))
+    store = Path(_normalize_cli_path(store_path))
+    _ensure_directory(workspace, "workspace-ref")
+    _ensure_directory(artifacts, "artifact-dir")
+    _ensure_directory(store.parent, "store-path parent")
+    return str(workspace), str(artifacts), str(store)
+
+
+def _ensure_directory(path: Path, ref: str) -> None:
+    try:
+        path.mkdir(parents=True, exist_ok=True)
+    except OSError as exc:
+        raise OSError(f"failed to create {ref} directory at {path}: {exc}") from exc
+    if not path.is_dir():
+        raise ValueError(f"{ref} is not a directory: {path}")
+
+
 def _mapping(value: Any, ref: str) -> Mapping[str, Any]:
     if not isinstance(value, Mapping):
         raise ValueError(f"{ref} must be a mapping")
diff --git a/tests/test_workflow_a_cli.py b/tests/test_workflow_a_cli.py
