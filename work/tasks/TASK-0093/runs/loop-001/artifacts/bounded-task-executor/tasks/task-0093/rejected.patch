+def _ensure_claim_graph_references_boundary(boundary_contract: BoundaryContract, claim_graph: ClaimGraph) -> None:
+    unknown_refs: set[str] = set()
+    blocked_refs: set[str] = set()
+    claim_refs: dict[str, list[str]] = {}
+    entry_ids = boundary_contract.entry_ids
+    blocked_entry_ids = boundary_contract.blocked_entry_ids
+    for claim in claim_graph.claims:
+        for criterion_ref in claim.criterion_refs:
+            if criterion_ref not in entry_ids:
+                unknown_refs.add(criterion_ref)
+                claim_refs.setdefault(claim.claim_id, []).append(criterion_ref)
+            elif criterion_ref in blocked_entry_ids:
+                blocked_refs.add(criterion_ref)
+                claim_refs.setdefault(claim.claim_id, []).append(criterion_ref)
+    if unknown_refs:
+        unresolved = tuple(sorted(unknown_refs))
+        raise AlignmentSessionError(
+            "unresolved_boundary_criterion_refs",
+            "ClaimGraph criterionRefs must reference IDs in the frozen boundary contract",
+            ref="claimGraph.spec.claims[].criterionRefs",
+            refs=unresolved,
+            data={
+                "unresolvedCriterionRefs": list(unresolved),
+                "claimCriterionRefs": {key: sorted(value) for key, value in sorted(claim_refs.items())},
+            },
+        )
+    if blocked_refs:
+        blocked = tuple(sorted(blocked_refs))
+        raise AlignmentSessionError(
+            "unclaimable_boundary_criterion_refs",
+            "ClaimGraph criterionRefs cannot reference free_zone or open_question boundary entries",
+            ref="claimGraph.spec.claims[].criterionRefs",
+            refs=blocked,
+            data={
+                "unclaimableCriterionRefs": list(blocked),
+                "claimCriterionRefs": {key: sorted(value) for key, value in sorted(claim_refs.items())},
+            },
+        )
+
+
+def _ensure_requirement_did_not_rewrite_claim_graph(
+    requirement: Mapping[str, Any],
+    frozen_claim_graph_digest: str | None,
+) -> None:
+    candidate = requirement.get("claimGraph") or requirement.get("claim_graph")
+    if candidate is None or frozen_claim_graph_digest is None:
+        return
+    candidate_digest = canonical_fingerprint(_mapping(candidate, "RequirementDraft.claimGraph"))
+    if candidate_digest != frozen_claim_graph_digest:
+        raise AlignmentSessionError(
+            "frozen_claim_graph_digest_mismatch",
+            "Requirement Agent output attempted to alter the frozen ClaimGraph",
+            ref="RequirementDraft.claimGraph",
+            refs=(frozen_claim_graph_digest, candidate_digest),
+            data={"expectedDigest": frozen_claim_graph_digest, "actualDigest": candidate_digest},
+        )
+
+
+def _ensure_plan_claim_refs_resolve(plan: PlanDraft, claim_graph: ClaimGraph) -> None:
+    claim_ids = {claim.claim_id for claim in claim_graph.claims}
+    unresolved_by_node: dict[str, list[str]] = {}
+    for node in plan.nodes:
+        missing = sorted(claim_ref for claim_ref in node.claim_refs if claim_ref not in claim_ids)
+        if missing:
+            unresolved_by_node[node.node_id] = missing
+    if not unresolved_by_node:
+        return
+    unresolved = tuple(sorted({claim_ref for refs in unresolved_by_node.values() for claim_ref in refs}))
+    raise AlignmentSessionError(
+        "unresolved_plan_claim_refs",
+        "PlanDraft node claimRefs must resolve to Claim IDs in the frozen ClaimGraph",
+        ref="planDraft.spec.nodes[].claimRefs",
+        refs=unresolved,
+        data={
+            "unresolvedClaimRefs": list(unresolved),
+            "nodeClaimRefs": unresolved_by_node,
+        },
+    )
+
