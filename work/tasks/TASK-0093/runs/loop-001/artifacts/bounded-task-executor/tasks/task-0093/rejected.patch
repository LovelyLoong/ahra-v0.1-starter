--- /dev/null
+++ b/src/ahra/boundary_contract.py
@@ -0,0 +1,242 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import StrEnum
+from typing import Any, Mapping, Sequence
+
+
+SUPPORTED_API_VERSION = "ahra.dev/v1alpha1"
+
+
+class BoundaryEntryKind(StrEnum):
+    MUST = "must"
+    MUST_NOT = "must_not"
+    COMPLETION_SIGNAL = "completion_signal"
+    FREE_ZONE = "free_zone"
+    OPEN_QUESTION = "open_question"
+
+
+CLAIMABLE_ENTRY_KINDS = {
+    BoundaryEntryKind.MUST,
+    BoundaryEntryKind.MUST_NOT,
+    BoundaryEntryKind.COMPLETION_SIGNAL,
+}
+
+
+class BoundaryContractError(ValueError):
+    def __init__(
+        self,
+        code: str,
+        message: str,
+        *,
+        ref: str,
+        refs: tuple[str, ...] = (),
+        data: Mapping[str, Any] | None = None,
+    ) -> None:
+        self.code = code
+        self.message = message
+        self.ref = ref
+        self.refs = refs or (ref,)
+        self.data = dict(data or {})
+        super().__init__(f"{code} {ref}: {message}")
+
+
+@dataclass(frozen=True, slots=True)
+class BoundaryEntry:
+    entry_id: str
+    kind: BoundaryEntryKind
+    text: str
+
+    @classmethod
+    def from_mapping(cls, data: Mapping[str, Any]) -> "BoundaryEntry":
+        entry_id = _required_string(data, "id", "BoundaryEntry.id")
+        text = _required_string(data, "text", f"{entry_id}.text")
+        try:
+            kind = BoundaryEntryKind(str(data["kind"]))
+        except (KeyError, ValueError) as exc:
+            raise BoundaryContractError(
+                "invalid_boundary_entry_kind",
+                "Boundary entry kind must be must, must_not, completion_signal, free_zone, or open_question",
+                ref=f"{entry_id}.kind",
+                refs=(entry_id,),
+            ) from exc
+        return cls(entry_id=entry_id, kind=kind, text=text)
+
+    def to_mapping(self) -> dict[str, str]:
+        return {
+            "id": self.entry_id,
+            "kind": self.kind.value,
+            "text": self.text,
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class BoundaryContract:
+    goal_ref: str
+    version: int
+    entries: tuple[BoundaryEntry, ...]
+
+    @classmethod
+    def from_mapping(cls, data: Mapping[str, Any]) -> "BoundaryContract":
+        if data.get("kind") == "BoundaryContract":
+            metadata = _mapping(data["metadata"], "BoundaryContract.metadata")
+            spec = _mapping(data["spec"], "BoundaryContract.spec")
+            goal_ref = _required_string(metadata, "goalRef", "BoundaryContract.metadata.goalRef")
+            version = int(metadata.get("version", 1))
+            entries_data = spec.get("entries")
+        else:
+            metadata = _mapping(data.get("metadata", {}), "BoundaryContract.metadata")
+            goal_ref = _optional_string(metadata.get("goalRef")) or _optional_string(data.get("goalRef"))
+            version = int(metadata.get("version", data.get("version", 1)))
+            entries_data = data.get("entries", data.get("frozenBoundary"))
+            if goal_ref is None:
+                goal_ref = "GOAL-UNSPECIFIED"
+        return cls.from_entries(goal_ref=goal_ref, version=version, entries_data=entries_data)
+
+    @classmethod
+    def from_entries(
+        cls,
+        *,
+        goal_ref: str,
+        version: int = 1,
+        entries_data: Any,
+    ) -> "BoundaryContract":
+        if not isinstance(entries_data, Sequence) or isinstance(entries_data, (str, bytes, bytearray)):
+            raise BoundaryContractError(
+                "invalid_boundary_entries",
+                "Boundary contract entries must be a list of boundary entry mappings",
+                ref="BoundaryContract.spec.entries",
+            )
+        entries = tuple(BoundaryEntry.from_mapping(_mapping(item, "BoundaryContract.spec.entries[]")) for item in entries_data)
+        contract = cls(goal_ref=goal_ref, version=version, entries=entries)
+        contract._validate()
+        return contract
+
+    @classmethod
+    def from_text(cls, *, goal_ref: str, text: str) -> "BoundaryContract":
+        return cls.from_entries(
+            goal_ref=goal_ref,
+            entries_data=[
+                {
+                    "id": "REQ-FROZEN-REQUIREMENT",
+                    "kind": BoundaryEntryKind.COMPLETION_SIGNAL.value,
+                    "text": text,
+                }
+            ],
+        )
+
+    @property
+    def entry_ids(self) -> frozenset[str]:
+        return frozenset(entry.entry_id for entry in self.entries)
+
+    @property
+    def claimable_entry_ids(self) -> frozenset[str]:
+        return frozenset(entry.entry_id for entry in self.entries if entry.kind in CLAIMABLE_ENTRY_KINDS)
+
+    @property
+    def blocked_entry_ids(self) -> frozenset[str]:
+        return self.entry_ids - self.claimable_entry_ids
+
+    def ensure_freezable(self) -> None:
+        open_questions = tuple(entry.entry_id for entry in self.entries if entry.kind == BoundaryEntryKind.OPEN_QUESTION)
+        if open_questions:
+            raise BoundaryContractError(
+                "boundary_open_questions",
+                "Boundary contract cannot be frozen while open_question entries remain",
+                ref="BoundaryContract.spec.entries",
+                refs=open_questions,
+                data={"openQuestionRefs": list(open_questions)},
+            )
+
+    def to_summary(self) -> str:
+        return "\n".join(f"{entry.entry_id} [{entry.kind.value}]: {entry.text}" for entry in self.entries)
+
+    def to_mapping(self) -> dict[str, Any]:
+        return {
+            "apiVersion": SUPPORTED_API_VERSION,
+            "kind": "BoundaryContract",
+            "metadata": {
+                "goalRef": self.goal_ref,
+                "version": self.version,
+            },
+            "spec": {
+                "entries": [entry.to_mapping() for entry in self.entries],
+            },
+        }
+
+    def _validate(self) -> None:
+        if not self.entries:
+            raise BoundaryContractError(
+                "empty_boundary_contract",
+                "Boundary contract must contain at least one entry",
+                ref="BoundaryContract.spec.entries",
+            )
+        ids = [entry.entry_id for entry in self.entries]
+        duplicates = tuple(sorted({entry_id for entry_id in ids if ids.count(entry_id) > 1}))
+        if duplicates:
+            raise BoundaryContractError(
+                "duplicate_boundary_entry_id",
+                "Boundary contract entry IDs must be unique",
+                ref="BoundaryContract.spec.entries",
+                refs=duplicates,
+                data={"duplicateEntryIds": list(duplicates)},
+            )
+
+
+def boundary_contract_from_value(
+    value: Any,
+    *,
+    goal_ref: str,
+    fallback_text: str | None = None,
+) -> BoundaryContract:
+    if isinstance(value, BoundaryContract):
+        return value
+    if value is None:
+        if fallback_text:
+            return BoundaryContract.from_text(goal_ref=goal_ref, text=fallback_text)
+        raise BoundaryContractError(
+            "missing_boundary_contract",
+            "Frozen alignment must include a boundary contract",
+            ref="agentOutput.boundaryContract",
+        )
+    if isinstance(value, Mapping):
+        data = dict(value)
+        if "metadata" not in data and "goalRef" not in data:
+            data["goalRef"] = goal_ref
+        return BoundaryContract.from_mapping(data)
+    if isinstance(value, Sequence) and not isinstance(value, (str, bytes, bytearray)):
+        return BoundaryContract.from_entries(goal_ref=goal_ref, entries_data=value)
+    raise BoundaryContractError(
+        "invalid_boundary_contract",
+        "Boundary contract must be a mapping or list of boundary entries",
+        ref="agentOutput.boundaryContract",
+    )
+
+
+def _required_string(data: Mapping[str, Any], key: str, ref: str) -> str:
+    value = data.get(key)
+    if not isinstance(value, str) or not value.strip():
+        raise BoundaryContractError("missing_boundary_string", f"{key} must be a non-empty string", ref=ref)
+    return value
+
+
+def _optional_string(value: Any) -> str | None:
+    if value is None:
+        return None
+    text = str(value).strip()
+    return text or None
+
+
+def _mapping(value: Any, ref: str) -> Mapping[str, Any]:
+    if not isinstance(value, Mapping):
+        raise BoundaryContractError("invalid_boundary_mapping", f"{ref} must be a mapping", ref=ref)
+    return value
+
+
+__all__ = [
+    "BoundaryContract",
+    "BoundaryContractError",
+    "BoundaryEntry",
+    "BoundaryEntryKind",
+    "boundary_contract_from_value",
+]
