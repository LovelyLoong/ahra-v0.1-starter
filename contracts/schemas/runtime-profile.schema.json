{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/runtime-profile.v1alpha1.json",
  "title": "AHRA Runtime Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "RuntimeProfile"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerClass",
        "image",
        "user",
        "filesystem",
        "network",
        "resources",
        "timeoutSeconds",
        "snapshot",
        "secrets"
      ],
      "properties": {
        "providerClass": {
          "enum": [
            "local-process",
            "oci-container",
            "hardened-container",
            "remote-sandbox",
            "microvm"
          ]
        },
        "image": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "writableMounts",
            "deniedPaths"
          ],
          "properties": {
            "root": {
              "enum": [
                "read_only",
                "writable"
              ]
            },
            "writableMounts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "path"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              }
            },
            "deniedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "allow"
          ],
          "properties": {
            "default": {
              "enum": [
                "deny",
                "allow"
              ]
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "host",
                  "ports"
                ],
                "properties": {
                  "host": {
                    "type": "string"
                  },
                  "ports": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  }
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memoryMiB",
            "ephemeralDiskMiB",
            "processLimit"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memoryMiB": {
              "type": "integer",
              "minimum": 64
            },
            "ephemeralDiskMiB": {
              "type": "integer",
              "minimum": 64
            },
            "processLimit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "injection",
            "persistInSnapshot"
          ],
          "properties": {
            "injection": {
              "enum": [
                "none",
                "environment",
                "short_lived_files",
                "brokered_calls"
              ]
            },
            "persistInSnapshot": {
              "const": false
            }
          }
        }
      }
    }
  }
}
