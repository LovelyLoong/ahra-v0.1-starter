{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/memory-record.0.1.json",
  "title": "AHRA Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "kind",
    "scope",
    "content",
    "status",
    "confidence",
    "source_refs",
    "created_by",
    "created_at",
    "sensitivity",
    "retention_policy",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": "ahra/memory-record/0.1"
    },
    "memory_id": {
      "type": "string",
      "pattern": "^MEM-"
    },
    "kind": {
      "enum": [
        "working",
        "episodic",
        "semantic",
        "procedural"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "candidate",
        "active",
        "rejected",
        "superseded",
        "expired",
        "tombstoned"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_after": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "personal",
        "restricted"
      ]
    },
    "retention_policy": {
      "type": "string"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^MEM-"
      }
    }
  }
}
