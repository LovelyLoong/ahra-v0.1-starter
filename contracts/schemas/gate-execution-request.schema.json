{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/gate-execution-request.v1alpha1.json",
  "title": "AHRA GateExecutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ahra.dev/v1alpha1" },
    "kind": { "const": "GateExecutionRequest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "createdAt"],
      "properties": {
        "requestId": { "type": "string", "pattern": "^GEXREQ-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalExecutionId",
        "planExecutionId",
        "gateRef",
        "gateKind",
        "runnerReleaseRef",
        "gateDefinitionDigest",
        "claimRefs",
        "level",
        "evidenceKind",
        "subjects",
        "dependencyEvidence",
        "environment",
        "idempotencyKey",
        "attempt",
        "mutationAllowed"
      ],
      "properties": {
        "goalExecutionId": { "type": "string", "minLength": 1 },
        "planExecutionId": { "type": "string", "minLength": 1 },
        "nodeRunId": { "type": ["string", "null"] },
        "gateRef": { "$ref": "#/$defs/gateId" },
        "gateKind": { "type": "string", "minLength": 1 },
        "runnerReleaseRef": { "type": "string", "minLength": 1 },
        "gateDefinitionDigest": { "$ref": "#/$defs/sha256Digest" },
        "claimRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimId" } },
        "level": { "enum": ["L0", "L1", "L2"] },
        "evidenceKind": { "type": "string", "minLength": 1 },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/digestRef" } },
        "dependencyEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidenceRef", "fingerprint"],
            "properties": {
              "evidenceRef": { "$ref": "#/$defs/evidenceId" },
              "fingerprint": { "$ref": "#/$defs/sha256Digest" }
            }
          }
        },
        "environment": { "$ref": "#/$defs/environment" },
        "workspaceRef": { "type": ["string", "null"] },
        "idempotencyKey": { "$ref": "#/$defs/sha256Digest" },
        "attempt": { "type": "integer", "minimum": 1 },
        "command": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "timeoutSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "mutationAllowed": { "type": "boolean" },
        "metadata": { "type": "object" }
      }
    }
  },
  "$defs": {
    "claimId": { "type": "string", "pattern": "^CLAIM-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeProfileDigest", "policyDigest", "verifierReleaseDigest", "testDefinitionDigest"],
      "properties": {
        "runtimeProfileDigest": { "$ref": "#/$defs/sha256Digest" },
        "policyDigest": { "$ref": "#/$defs/sha256Digest" },
        "verifierReleaseDigest": { "$ref": "#/$defs/sha256Digest" },
        "testDefinitionDigest": { "$ref": "#/$defs/sha256Digest" },
        "relevantEnvironmentDigest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "evidenceId": { "type": "string", "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "gateId": { "type": "string", "pattern": "^GATE-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
