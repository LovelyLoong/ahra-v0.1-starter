{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/gate-execution-result.v1alpha1.json",
  "title": "AHRA GateExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ahra.dev/v1alpha1" },
    "kind": { "const": "GateExecutionResult" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultId", "createdAt"],
      "properties": {
        "resultId": { "type": "string", "pattern": "^GEXRES-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateRef",
        "status",
        "startedAt",
        "completedAt",
        "artifactRefs",
        "subjects",
        "dependencies",
        "command",
        "usage",
        "cost",
        "failureClass",
        "reason",
        "rawOutputRef"
      ],
      "properties": {
        "gateRef": { "$ref": "#/$defs/gateId" },
        "status": { "enum": ["passed", "failed", "blocked", "error", "timed_out", "canceled"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "decisionAt": { "type": ["string", "null"], "format": "date-time" },
        "artifactRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "subjects": { "type": "array", "items": { "$ref": "#/$defs/digestRef" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/digestRef" } },
        "command": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "usage": { "type": "object" },
        "cost": { "type": "object" },
        "failureClass": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "rawOutputRef": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "gateId": { "type": "string", "pattern": "^GATE-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
