{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/verification-execution-report.v1alpha1.json",
  "title": "AHRA VerificationExecutionReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ahra.dev/v1alpha1" },
    "kind": { "const": "VerificationExecutionReport" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "createdAt"],
      "properties": {
        "reportId": { "type": "string", "pattern": "^VEXECRPT-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "selectedGateRefs",
        "executedGateRunRefs",
        "reusedEvidenceRefs",
        "attempts",
        "passed",
        "metrics",
        "duplicateIdempotencyKeys"
      ],
      "properties": {
        "selection": { "$ref": "#/$defs/selection" },
        "selectedGateRefs": { "type": "array", "items": { "$ref": "#/$defs/gateId" } },
        "executedGateRunRefs": { "type": "array", "items": { "$ref": "#/$defs/gateRunId" } },
        "reusedEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceId" } },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
        "passed": { "type": "boolean" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "duplicateIdempotencyKeys": { "type": "array", "items": { "$ref": "#/$defs/sha256Digest" } }
      }
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateRef", "status", "level", "gateRunRef", "evidenceRef", "failureClass", "message"],
      "properties": {
        "gateRef": { "$ref": "#/$defs/gateId" },
        "status": { "enum": ["passed", "failed", "blocked", "error", "timed_out", "canceled"] },
        "level": { "type": ["string", "null"], "enum": ["L0", "L1", "L2", null] },
        "gateRunRef": { "type": ["string", "null"], "pattern": "^GATERUN-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
        "evidenceRef": { "type": ["string", "null"], "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
        "failureClass": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "claimId": { "type": "string", "pattern": "^CLAIM-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "evidenceId": { "type": "string", "pattern": "^EVD-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "gateId": { "type": "string", "pattern": "^GATE-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "gateRunId": { "type": "string", "pattern": "^GATERUN-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateExecutionIntegrity",
        "unrunGatePassCount",
        "gateRunCountByStatus",
        "gateRunCountByLevel",
        "gateRunCountByGate",
        "evidenceWithValidGateRunLineage",
        "newEvidenceCount"
      ],
      "properties": {
        "gateExecutionIntegrity": { "type": "number", "minimum": 0, "maximum": 1 },
        "unrunGatePassCount": { "type": "integer", "minimum": 0 },
        "gateRunCountByStatus": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "gateRunCountByLevel": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "gateRunCountByGate": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "evidenceWithValidGateRunLineage": { "type": "integer", "minimum": 0 },
        "newEvidenceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedGateRefs", "fullGateRefs", "affectedClaimRefs", "reusedEvidenceRefs", "staleEvidenceRefs", "historicalEvidenceRefs", "resolutionFailureRefs", "rationale"],
      "properties": {
        "selectedGateRefs": { "type": "array", "items": { "$ref": "#/$defs/gateId" } },
        "fullGateRefs": { "type": "array", "items": { "$ref": "#/$defs/gateId" } },
        "affectedClaimRefs": { "type": "array", "items": { "$ref": "#/$defs/claimId" } },
        "reusedEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceId" } },
        "staleEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceId" } },
        "historicalEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceId" } },
        "resolutionFailureRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceId" } },
        "rationale": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sha256Digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
