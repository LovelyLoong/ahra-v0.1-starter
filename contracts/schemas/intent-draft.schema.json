{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/intent-draft.v1alpha1.json",
  "title": "AHRA IntentDraft",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "IntentDraft"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "intentId",
        "name"
      ],
      "properties": {
        "intentId": {
          "type": "string",
          "pattern": "^INTENT-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "abstractGoal",
        "constraints",
        "capabilityNeeds",
        "context"
      ],
      "properties": {
        "abstractGoal": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "capabilityNeeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityNeed"
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        },
        "priorityHint": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "riskHint": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "requester": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "capabilityNeed": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "action",
        "resources"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "$ref": "#/$defs/stringList"
        },
        "reason": {
          "type": "string"
        },
        "riskLevel": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "policyRefs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
