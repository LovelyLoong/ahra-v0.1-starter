{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/workflow-resume-request.v1alpha1.json",
  "title": "AHRA Workflow Resume Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "WorkflowResumeRequest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "moduleId",
        "workspaceRef",
        "driverRef",
        "storeRef",
        "artifactDir",
        "approval"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^RUN-[A-Za-z0-9._-]+$"
        },
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "workspaceRef": {
          "type": "string",
          "minLength": 1
        },
        "driverRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "storeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "artifactDir": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseCommit": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "approved",
            "reason",
            "planArtifact",
            "expectedPlanSha256"
          ],
          "properties": {
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "approved": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "planArtifact": {
              "type": "string",
              "minLength": 1
            },
            "expectedPlanSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "approvedTaskIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{1,127}$"
              }
            }
          }
        }
      }
    }
  }
}
