{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/plan-validation-report.v1alpha1.json",
  "title": "AHRA PlanValidationReport",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9_.-]+$": {}
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "PlanValidationReport"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportId",
        "createdBy"
      ],
      "properties": {
        "reportId": {
          "type": "string",
          "pattern": "^PLANVAL-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectRef",
        "subjectDigest",
        "result",
        "errors",
        "refs"
      ],
      "properties": {
        "subjectRef": {
          "type": "string",
          "minLength": 1
        },
        "subjectDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error"
          }
        },
        "refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "ref"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,127}$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
