{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/goal-contract.v1alpha1.json",
  "title": "AHRA GoalContract",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9_.-]+$": {}
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "GoalContract"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9_.-]+$": {}
      },
      "required": [
        "name",
        "goalId",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "goalId": {
          "type": "string",
          "pattern": "^GOAL-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9_.-]+$": {}
      },
      "required": [
        "objective",
        "criteria",
        "mandatoryClaimTypes"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "boundaries": {
          "$ref": "#/$defs/stringList"
        },
        "riskLevel": {
          "$ref": "#/$defs/riskLevel"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "mandatoryClaimTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimType"
          }
        }
      }
    }
  },
  "$defs": {
    "claimType": {
      "enum": [
        "functional",
        "structural",
        "quality",
        "security",
        "operational",
        "governance"
      ]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9_.-]+$": {}
      },
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CRIT-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "riskLevel": {
          "$ref": "#/$defs/riskLevel"
        }
      }
    },
    "riskLevel": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
