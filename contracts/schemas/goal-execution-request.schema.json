{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/goal-execution-request.v1alpha1.json",
  "title": "AHRA GoalExecutionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "GoalExecutionRequest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "idempotencyKey"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileRef",
        "workspaceRef",
        "artifactDir",
        "store",
        "planner",
        "executor",
        "gateRunner",
        "runtime",
        "goal",
        "registry",
        "planDraft"
      ],
      "properties": {
        "profileRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "workspaceRef": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifactDir": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "sqlite"
            },
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "planner": {
          "$ref": "#/$defs/adapterRefObject"
        },
        "executor": {
          "$ref": "#/$defs/adapterRefObject"
        },
        "gateRunner": {
          "$ref": "#/$defs/adapterRefObject"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimeRef",
            "digest"
          ],
          "properties": {
            "runtimeRef": {
              "$ref": "#/$defs/immutableRef"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goalRef",
            "goalDigest",
            "claimGraphDigest",
            "requiredClaimRefs"
          ],
          "properties": {
            "goalRef": {
              "type": "string",
              "pattern": "^GOAL-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
            },
            "goalDigest": {
              "$ref": "#/$defs/digest"
            },
            "claimGraphRef": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "claimGraphDigest": {
              "$ref": "#/$defs/digest"
            },
            "requiredClaimRefs": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeTypes",
            "gateRefs",
            "runtimeRefs",
            "allowedCapabilities"
          ],
          "properties": {
            "nodeTypes": {
              "$ref": "#/$defs/digestMap"
            },
            "gateRefs": {
              "$ref": "#/$defs/digestMap"
            },
            "runtimeRefs": {
              "$ref": "#/$defs/digestMap"
            },
            "allowedCapabilities": {
              "$ref": "#/$defs/stringList"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRepairCycles": {
              "type": "integer",
              "minimum": 0
            },
            "maxConcurrency": {
              "type": "integer",
              "minimum": 1
            },
            "branch": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "planDraft": {
          "type": "object",
          "required": [
            "apiVersion",
            "kind",
            "metadata",
            "spec"
          ],
          "properties": {
            "apiVersion": {
              "const": "ahra.dev/v1alpha1"
            },
            "kind": {
              "const": "PlanDraft"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "adapterRefObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapterRef"
      ],
      "properties": {
        "adapterRef": {
          "$ref": "#/$defs/immutableRef"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "digestMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      }
    },
    "immutableRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+@sha256:[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
