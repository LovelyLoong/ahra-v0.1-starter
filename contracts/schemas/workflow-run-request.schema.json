{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/workflow-run-request.v1alpha1.json",
  "title": "AHRA Workflow Run Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "WorkflowRunRequest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "input",
        "workspaceRef",
        "driverRef",
        "storeRef",
        "approvalMode"
      ],
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "taskRef": {
              "type": "string",
              "minLength": 1
            },
            "goalRef": {
              "type": "string",
              "minLength": 1
            },
            "task": {
              "$ref": "#/$defs/taskSpec"
            },
            "goal": {
              "$ref": "#/$defs/goalSpec"
            }
          },
          "oneOf": [
            { "required": ["taskRef"] },
            { "required": ["task"] },
            { "required": ["goalRef"] },
            { "required": ["goal"] }
          ]
        },
        "workspaceRef": {
          "type": "string",
          "minLength": 1
        },
        "driverRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "storeRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "artifactDir": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^RUN-[A-Za-z0-9._-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "baseCommit": {
          "type": "string",
          "minLength": 1
        },
        "approvalMode": {
          "enum": [
            "manual",
            "auto",
            "disabled"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "moduleId": { "const": "standard-harness" } },
            "required": ["moduleId"]
          },
          "then": {
            "properties": {
              "input": {
                "anyOf": [
                  { "required": ["taskRef"] },
                  { "required": ["task"] }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "moduleId": { "const": "loop-engineering" } },
            "required": ["moduleId"]
          },
          "then": {
            "properties": {
              "input": {
                "anyOf": [
                  { "required": ["goalRef"] },
                  { "required": ["goal"] }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checkSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "changePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_globs": {
          "$ref": "#/$defs/requiredStringList"
        },
        "protected_globs": {
          "$ref": "#/$defs/stringList"
        },
        "sensitive_globs": {
          "$ref": "#/$defs/stringList"
        },
        "max_changed_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_added_lines": {
          "type": "integer",
          "minimum": 0
        },
        "max_deleted_lines": {
          "type": "integer",
          "minimum": 0
        },
        "allow_no_changes": {
          "type": "boolean"
        }
      }
    },
    "taskSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "$ref": "#/$defs/requiredStringList"
        },
        "scope": {
          "$ref": "#/$defs/stringList"
        },
        "requirements": {
          "$ref": "#/$defs/stringList"
        },
        "non_goals": {
          "$ref": "#/$defs/stringList"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkSpec"
          }
        },
        "policy": {
          "$ref": "#/$defs/changePolicy"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "goalSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "success_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "success_criteria": {
          "$ref": "#/$defs/requiredStringList"
        },
        "boundaries": {
          "$ref": "#/$defs/stringList"
        },
        "policy": {
          "$ref": "#/$defs/changePolicy"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskSpec"
          }
        },
        "global_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkSpec"
          }
        },
        "max_cycles": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "dynamic_planning": {
          "type": "boolean"
        },
        "auto_execute_proposed_tasks": {
          "type": "boolean"
        }
      },
      "anyOf": [
        { "required": ["tasks"] },
        {
          "properties": {
            "dynamic_planning": { "const": true }
          },
          "required": ["dynamic_planning"]
        }
      ]
    }
  }
}
