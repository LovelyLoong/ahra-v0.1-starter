{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/workflow-sequence.v1alpha1.json",
  "title": "AHRA WorkflowSequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "WorkflowSequence"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sequenceId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "sequenceId": {
          "type": "string",
          "pattern": "^WSEQ-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks"
      ],
      "properties": {
        "workRoot": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "producerActor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "verifierActor": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "maxCycles": {
          "type": "integer",
          "minimum": 1
        },
        "leaseTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "taskDefaults": {
          "$ref": "#/$defs/taskDefaults"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "verificationStrategy": {
      "enum": [
        "simple",
        "comprehensive"
      ]
    },
    "taskDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verificationStrategy": {
          "$ref": "#/$defs/verificationStrategy"
        },
        "goalRequest": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "goalRequestTemplate": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewReport": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewReportTemplate": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "verificationStrategy"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}$"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
          }
        },
        "verificationStrategy": {
          "$ref": "#/$defs/verificationStrategy"
        },
        "goalRequest": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "goalRequestTemplate": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewReport": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewReportTemplate": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
