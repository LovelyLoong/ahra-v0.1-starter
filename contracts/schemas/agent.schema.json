{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/agent.v1alpha1.json",
  "title": "AHRA Agent Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "Agent"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions",
        "modelPolicy",
        "tools",
        "memoryPolicy",
        "runtimeProfileRef",
        "budgets",
        "evalSuites"
      ],
      "properties": {
        "instructions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refs"
          ],
          "properties": {
            "refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "inputSchemaRef": {
          "type": "string"
        },
        "outputSchemaRef": {
          "type": "string"
        },
        "modelPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "requiredCapabilities",
            "fallbackPolicy"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "requiredCapabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "fallbackPolicy": {
              "enum": [
                "none",
                "explicit-compatible-only",
                "policy-controlled"
              ]
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grants"
          ],
          "properties": {
            "grants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool",
                  "mode"
                ],
                "properties": {
                  "tool": {
                    "type": "string"
                  },
                  "mode": {
                    "enum": [
                      "allow",
                      "allow_with_policy",
                      "human_approval",
                      "deny"
                    ]
                  }
                }
              }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              }
            }
          }
        },
        "memoryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readScopes",
            "writeScopes",
            "directPermanentWrite"
          ],
          "properties": {
            "readScopes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "writeScopes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "directPermanentWrite": {
              "const": false
            }
          }
        },
        "runtimeProfileRef": {
          "type": "string"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wallTimeSeconds",
            "maxModelCalls",
            "maxToolCalls",
            "maxSubtasks",
            "maxCostUsd"
          ],
          "properties": {
            "wallTimeSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 0
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 0
            },
            "maxSubtasks": {
              "type": "integer",
              "minimum": 0
            },
            "maxCostUsd": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "evalSuites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
