{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/workflow.v1alpha1.json",
  "title": "AHRA Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "owner"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "steps"
      ],
      "properties": {
        "entrypoint": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "deterministic",
                  "agent",
                  "parallel",
                  "approval",
                  "verify",
                  "publish"
                ]
              },
              "agentRef": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "onFailure": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
