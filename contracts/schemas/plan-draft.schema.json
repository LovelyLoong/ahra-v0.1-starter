{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/plan-draft.v1alpha1.json",
  "title": "AHRA PlanDraft",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[A-Za-z0-9_.-]+$": {}
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "PlanDraft"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9_.-]+$": {}
      },
      "required": [
        "goalId",
        "proposedBy"
      ],
      "properties": {
        "goalId": {
          "$ref": "#/$defs/goalRef"
        },
        "proposedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9_.-]+$": {}
      },
      "required": [
        "nodes"
      ],
      "properties": {
        "rationale": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/planNodeDraft"
          }
        }
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxModelCalls",
        "maxToolCalls"
      ],
      "properties": {
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxSpawnedNodes": {
          "type": "integer",
          "minimum": 0
        },
        "maxWallSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "resources"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "$ref": "#/$defs/stringList"
        },
        "riskLevel": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "approvalRefs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "claimRef": {
      "type": "string",
      "pattern": "^CLAIM-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "gateRef": {
      "type": "string",
      "pattern": "^GATE-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "goalRef": {
      "type": "string",
      "pattern": "^GOAL-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "nodeRef": {
      "type": "string",
      "pattern": "^NODE-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schemaRef"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "consumerNodeRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeRef"
          }
        },
        "deliveryRole": {
          "enum": [
            "artifact",
            "evidence",
            "handoff",
            "terminal"
          ]
        },
        "artifactRequired": {
          "type": "boolean"
        }
      }
    },
    "planNodeDraft": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[A-Za-z0-9_.-]+$": {}
      },
      "required": [
        "id",
        "nodeType",
        "objective",
        "claimRefs",
        "dependsOn",
        "inputRefs",
        "expectedOutputs",
        "gateRefs",
        "budgetRequest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeRef"
        },
        "nodeType": {
          "enum": [
            "bounded_task",
            "gate_verification",
            "goal_verification",
            "repair"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "claimRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claimRef"
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeRef"
          }
        },
        "inputRefs": {
          "$ref": "#/$defs/stringList"
        },
        "expectedOutputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          }
        },
        "capabilityRequests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRequest"
          }
        },
        "gateRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gateRef"
          }
        },
        "runtimeRef": {
          "type": "string",
          "minLength": 1
        },
        "budgetRequest": {
          "$ref": "#/$defs/budget"
        },
        "retryPolicy": {
          "$ref": "#/$defs/retryPolicy"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "compensationRef": {
          "type": "string",
          "minLength": 1
        },
        "sideEffect": {
          "enum": [
            "idempotent",
            "non_idempotent"
          ]
        },
        "terminalGoalVerification": {
          "type": "boolean"
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "retryableFailureClasses": {
          "$ref": "#/$defs/stringList"
        },
        "idempotencyKeyRequired": {
          "type": "boolean"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
