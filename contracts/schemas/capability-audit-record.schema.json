{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahra.dev/schemas/capability-audit-record.v1alpha1.json",
  "title": "AHRA CapabilityAuditRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "ahra.dev/v1alpha1"
    },
    "kind": {
      "const": "CapabilityAuditRecord"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditId",
        "occurredAt"
      ],
      "properties": {
        "auditId": {
          "type": "string",
          "pattern": "^AUD-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "nodeId",
        "actor",
        "action",
        "allowed",
        "reasonCode",
        "policyDecisionId",
        "grantDigest",
        "argumentDigest",
        "resultDigest"
      ],
      "properties": {
        "planId": {
          "$ref": "#/$defs/planRef"
        },
        "nodeId": {
          "$ref": "#/$defs/nodeRef"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "allowed": {
          "type": "boolean"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "policyDecisionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^PDEC-"
            },
            {
              "type": "null"
            }
          ]
        },
        "grantDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "argumentDigest": {
          "$ref": "#/$defs/digest"
        },
        "resultDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "resourceScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceSummary": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nodeRef": {
      "type": "string",
      "pattern": "^NODE-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "planRef": {
      "type": "string",
      "pattern": "^PLAN-[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    }
  }
}
